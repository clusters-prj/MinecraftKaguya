# ==========================================
# Block Switcher System
# ==========================================

# 1. 鉄インゴットによるトグル機能 (ON/OFF)
on right click holding iron ingot:
    if name of player's tool is "&b&lBlockSwitcher&7(右クリック)":
        cancel event
        
        # 初期値の設定
        if {blockswitch::%player's uuid%} is not set:
            set {blockswitch::%player's uuid%} to false
        
        # トグル処理
        if {blockswitch::%player's uuid%} is true:
            set {blockswitch::%player's uuid%} to false
            play sound "block.iron_trapdoor.close" to player
        else:
            set {blockswitch::%player's uuid%} to true
            play sound "block.iron_trapdoor.open" to player

# 手に持っている間のアクションバー表示通知
every 10 ticks:
    loop all players:
        if loop-player's tool is iron ingot:
            if name of loop-player's tool is "&b&lBlockSwitcher&7(右クリック)":
                if {blockswitch::%loop-player's uuid%} is true:
                    send action bar "&6&l✔ ブロック持ち替え機能: ON" to loop-player
                else:
                    send action bar "&7&l✖ ブロック持ち替え機能: OFF" to loop-player

# 2. 空中右クリック時のブロック変換機能
on right click:
    if {blockswitch::%player's uuid%} is true:
        if targeted block is not set:
            set {_item} to player's tool
            set {_type} to type of {_item}
            
            # --- 石系（フル -> 階段 -> ハーフ -> 塀 -> フル） ---
            
            # 石 (Stone)
            if {_type} is stone:
                set player's tool to stone stairs
            else if {_type} is stone stairs:
                set player's tool to stone slab
            else if {_type} is stone slab:
                set player's tool to stone brick wall
            else if {_type} is stone brick wall:
                set player's tool to stone

            # 石レンガ (Stone Bricks)
            else if {_type} is stone bricks:
                set player's tool to stone brick stairs
            else if {_type} is stone brick stairs:
                set player's tool to stone brick slab
            else if {_type} is stone brick slab:
                set player's tool to stone brick wall
            else if {_type} is stone brick wall:
                set player's tool to stone bricks

            # 丸石 (Cobblestone)
            else if {_type} is cobblestone:
                set player's tool to cobblestone stairs
            else if {_type} is cobblestone stairs:
                set player's tool to cobblestone slab
            else if {_type} is cobblestone slab:
                set player's tool to cobblestone wall
            else if {_type} is cobblestone wall:
                set player's tool to cobblestone

            # 苔むした丸石 (Mossy Cobblestone)
            else if {_type} is mossy cobblestone:
                set player's tool to mossy cobblestone stairs
            else if {_type} is mossy cobblestone stairs:
                set player's tool to mossy cobblestone slab
            else if {_type} is mossy cobblestone slab:
                set player's tool to mossy cobblestone wall
            else if {_type} is mossy cobblestone wall:
                set player's tool to mossy cobblestone

            # 花崗岩 (Granite)
