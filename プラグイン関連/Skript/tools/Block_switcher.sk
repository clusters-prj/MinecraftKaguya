                set player's tool to granite stairs
            else if {_type} is granite stairs:
                set player's tool to granite slab
            else if {_type} is granite slab:
                set player's tool to granite wall
            else if {_type} is granite wall:
                set player's tool to granite

            # 磨かれた花崗岩 (Polished Granite)
