options:
    prefix: &8[&cPvP&8]&r
    objective: pvp_score
    max-health: 60
    # 開始時に設定する最大体力(20 = ハート10個)
    drop-items: false
    # true: 死亡時に持ち物をその場に落とす / false: 持ち物は落とさず保持

# Minecraft Java/Paper 26.2 + Skript 2.15.2
# 対象は Minecraft の scoreboard tag "pvp" を持つプレイヤーのみ。
#
# /pvpstart : 開始・得点リセット
# /pvpstop  : 終了・1～3位発表
# /pvpshow  : サイドバー表示
# /pvphide  : サイドバー非表示

on load:
    execute console command "scoreboard objectives remove {@objective}"
    execute console command "scoreboard objectives add {@objective} dummy ""PvP Score"""
    execute console command "scoreboard objectives setdisplay sidebar"
    # 変数はリロードで消えるので、残っているスコアボード上の記録も消して揃える
    execute console command "scoreboard players reset * {@objective}"
    set {pvp.running} to false
    delete {pvp.score::*}
    delete {pvp.lastAttacker::*}
    delete {pvp.lastAttackerTime::*}
    delete {pvp.alarm::*}
    delete {pvp.deathLoc::*}

command /pvpstart:
    permission: pvp.admin
    executable by: players, console, command blocks
    trigger:
        set {pvp.running} to true
        delete {pvp.lastAttacker::*}
        delete {pvp.lastAttackerTime::*}
        delete {pvp.alarm::*}
        delete {pvp.deathLoc::*}
        delete {pvp.score::*}

        # 前回の記録を全て消してから、タグ持ちだけを登録し直す
        execute console command "scoreboard players reset * {@objective}"

        loop all players:
            if loop-player has scoreboard tag "pvp":
                set {pvp.score::%uuid of loop-player%} to 0
                execute console command "scoreboard players set %loop-player% {@objective} 0"
                set loop-player's gamemode to survival
                pvpSetupAttributes(loop-player)
                pvpGiveGlowPotion(loop-player)
                pvpGiveHealPotions(loop-player)

        broadcast "{@prefix} &aPvPを開始しました。"

command /pvpstop:
    permission: pvp.admin
    executable by: players, console, command blocks
    trigger:
        if {pvp.running} is not true:
            send "{@prefix} &ePvPは現在停止中です。" to sender
            stop

        set {pvp.running} to false

        delete {pvp.rankCandidates::*}
        loop all players:
            if loop-player has scoreboard tag "pvp":
                add loop-player to {pvp.rankCandidates::*}
                # 開始時に変更した最大体力を戻し、発光も解除する
                execute console command "attribute %loop-player% minecraft:max_health base reset"
                execute console command "effect clear %loop-player% minecraft:glowing"

        # 1位
        set {_bestScore} to -999999999
        delete {_bestPlayer}
        loop {pvp.rankCandidates::*}:
            set {_s} to {pvp.score::%uuid of loop-value%} otherwise 0
            if {_s} > {_bestScore}:
                set {_bestScore} to {_s}
                set {_bestPlayer} to loop-value
        if {_bestPlayer} is set:
            set {_rank1Name} to name of {_bestPlayer}
            set {_rank1Score} to {_bestScore}
            remove {_bestPlayer} from {pvp.rankCandidates::*}
        else:
            set {_rank1Name} to "なし"
            set {_rank1Score} to 0

        # 2位
        set {_bestScore} to -999999999
        delete {_bestPlayer}
        loop {pvp.rankCandidates::*}:
            set {_s} to {pvp.score::%uuid of loop-value%} otherwise 0
            if {_s} > {_bestScore}:
                set {_bestScore} to {_s}
                set {_bestPlayer} to loop-value
        if {_bestPlayer} is set:
            set {_rank2Name} to name of {_bestPlayer}
            set {_rank2Score} to {_bestScore}
            remove {_bestPlayer} from {pvp.rankCandidates::*}
        else:
            set {_rank2Name} to "なし"
            set {_rank2Score} to 0

        # 3位
        set {_bestScore} to -999999999
        delete {_bestPlayer}
        loop {pvp.rankCandidates::*}:
            set {_s} to {pvp.score::%uuid of loop-value%} otherwise 0
            if {_s} > {_bestScore}:
                set {_bestScore} to {_s}
                set {_bestPlayer} to loop-value
        if {_bestPlayer} is set:
            set {_rank3Name} to name of {_bestPlayer}
            set {_rank3Score} to {_bestScore}
        else:
            set {_rank3Name} to "なし"
            set {_rank3Score} to 0

        broadcast "&8&m-----------------------------"
        broadcast "&c&lPvP終了！"
        broadcast "&6 1位 &f%{_rank1Name}% &7- &e%{_rank1Score}%点"
        broadcast "&7 2位 &f%{_rank2Name}% &7- &e%{_rank2Score}%点"
        broadcast "&f 3位 &f%{_rank3Name}% &7- &e%{_rank3Score}%点"
        broadcast "&8&m-----------------------------"

        delete {pvp.rankCandidates::*}
        delete {pvp.lastAttacker::*}
        delete {pvp.lastAttackerTime::*}
        delete {pvp.alarm::*}

command /pvpshow:
    permission: pvp.admin
    executable by: players, console, command blocks
    trigger:
        execute console command "scoreboard objectives setdisplay sidebar {@objective}"
        send "{@prefix} &aスコアボードを表示しました。" to sender

command /pvphide:
    permission: pvp.admin
    executable by: players, console, command blocks
    trigger:
        execute console command "scoreboard objectives setdisplay sidebar"
        send "{@prefix} &eスコアボードを非表示にしました。" to sender

# PvP停止中に参加したpvpタグ持ちの最大体力を戻す(終了時にオフラインだった人向け)。
on join:
    if {pvp.running} is not true:
        if player has scoreboard tag "pvp":
            execute console command "attribute %player% minecraft:max_health base reset"
            execute console command "effect clear %player% minecraft:glowing"

# 持ち物の中から、名前(色コードを除く)に key を含むポーションの個数を数える。
# 配布時の名前の付け方(コンポーネント/レガシー)の違いに左右されないよう、
# 色を取り除いた文字列で比較する。
function pvpCountNamedPotions(p: player, key: text) :: integer:
    set {_n} to 0
    loop all items in inventory of {_p}:
        if loop-item is a potion:
            set {_name} to name of loop-item
            if {_name} is set:
                if uncolored {_name} contains {_key}:
                    add 1 to {_n}
    return {_n}

# 発光ポーション: インベントリに1個もない場合だけ補給する。
# 水入り瓶に専用名を付け、飲用イベントで発光効果を付与する。
function pvpGiveGlowPotion(p: player):
    if pvpCountNamedPotions({_p}, "発光ポーション") is 0:
        give a water bottle named "&e発光ポーション" with lore "&7飲むと8分間発光する" to {_p}

# 開始時の属性初期化: プレイヤー系の属性ベース値を全て初期値に戻し、最大体力だけ60にする。
# (装備・効果による修飾子は触らず、ベース値のみ初期化する)
function pvpSetupAttributes(p: player):
    set {_attrs::*} to "armor", "armor_toughness", "attack_damage", "attack_knockback", "attack_speed", "block_break_speed", "block_interaction_range", "burning_time", "camera_distance", "entity_interaction_range", "explosion_knockback_resistance", "fall_damage_multiplier", "gravity", "jump_strength", "knockback_resistance", "luck", "max_absorption", "max_health", "mining_efficiency", "movement_efficiency", "movement_speed", "oxygen_bonus", "safe_fall_distance", "scale", "sneaking_speed", "step_height", "submerged_mining_speed", "sweeping_damage_ratio", "water_movement_efficiency", "waypoint_receive_range" and "waypoint_transmit_range"
    loop {_attrs::*}:
        execute console command "attribute %{_p}% minecraft:%loop-value% base reset"
    execute console command "attribute %{_p}% minecraft:max_health base set {@max-health}"
    heal {_p}

# 即時回復IIIポーション: 持ち物に3個未満のとき、3個になるまで補給する。
# 名前付きポーションを数えて不足分だけ渡す(飲むと空き瓶が残る)。
function pvpGiveHealPotions(p: player):
    set {_have} to pvpCountNamedPotions({_p}, "即時回復III")
    set {_need} to 3 - {_have}
    if {_need} > 0:
        loop {_need} times:
            execute console command "give %{_p}% potion[potion_contents={custom_color:16711680,custom_effects:[{id:'minecraft:instant_health',amplifier:2,duration:1}]},custom_name={text:'即時回復III',color:'red',italic:false}] 1"

# 専用の水入り瓶を飲んだ場合だけ、発光を8分間付与する。
on consume:
    if event-item is a water bottle named "&e発光ポーション":
        execute console command "effect give %player% minecraft:glowing 480 0 true"
        send action bar "&e発光効果: 8分間" to player

# 死亡時の得点処理(キル +10 / それ以外の死亡 -5)
function pvpApplyDeath(v: player):
    # 通常の死亡・自死・環境死を含め、死亡時に発光効果を解除する。
    execute console command "effect clear %{_v}% minecraft:glowing"
    set {_killer} to {pvp.lastAttacker::%uuid of {_v}%}
    set {_playerKill} to false

    if {_killer} is set:
        if difference between now and {pvp.lastAttackerTime::%uuid of {_v}%} is less than 6 seconds:
            if {_killer} is online:
                if {_killer} has scoreboard tag "pvp":
                    if {_killer} is not {_v}:
                        set {_playerKill} to true

    if {_playerKill} is true:
        add 10 to {pvp.score::%uuid of {_killer}%}
        execute console command "scoreboard players add %{_killer}% {@objective} 10"
        broadcast "&c%name of {_killer}% &7killed &c%name of {_v}%"
    else:
        remove 5 from {pvp.score::%uuid of {_v}%}
        execute console command "scoreboard players remove %{_v}% {@objective} 5"
        broadcast "&c%name of {_v}% &7died."

    delete {pvp.lastAttacker::%uuid of {_v}%}
    delete {pvp.lastAttackerTime::%uuid of {_v}%}

# 復活の継続条件: オンライン・PvP実行中・pvpタグ持ち。
function pvpCanRespawn(v: player) :: boolean:
    if {_v} is not online:
        return false
    if {pvp.running} is not true:
        return false
    if {_v} does not have scoreboard tag "pvp":
        return false
    return true

# 復活カウントダウン(15秒)と復活処理。on damage / on respawn の両方から呼ぶ。
# 秒数や配布物を変えるときはここだけを直せばよい。
function pvpRespawnCountdown(v: player):
    loop 15 times:
        if pvpCanRespawn({_v}) is true:
            if {_v}'s gamemode is spectator:
                set {_remaining} to 16 - loop-number
                send action bar "&eRespawning in %{_remaining}%s" to {_v}
        wait 1 second

    if pvpCanRespawn({_v}) is true:
        heal {_v}
        set {_v}'s food level to 20
        set {_v}'s gamemode to survival
        pvpGiveGlowPotion({_v})
        pvpGiveHealPotions({_v})
    delete {pvp.spectating::%uuid of {_v}%}

# 直近のプレイヤー由来ダメージを記録。
# projectile の場合は shooter をたどる。
# 致死ダメージだった場合は、死なせずにその場でスペクテイターにする(リスポーン画面を出さない)。
on damage of player with priority highest:
    if {pvp.running} is not true:
        stop
    if victim does not have scoreboard tag "pvp":
        stop

    delete {_damager}

    if attacker is a player:
        if attacker has scoreboard tag "pvp":
            set {_damager} to attacker
    else:
        # attacker は entity 型のため、一度変数に入れてから shooter を取る
        set {_proj} to attacker
        if {_proj} is a projectile:
            set {_shooter} to shooter of {_proj}
            if {_shooter} is a player:
                if {_shooter} has scoreboard tag "pvp":
                    set {_damager} to {_shooter}

    if {_damager} is set:
        set {pvp.lastAttacker::%uuid of victim%} to {_damager}
        set {pvp.lastAttackerTime::%uuid of victim%} to now

    # ---- 致死ダメージ判定 ----
    if victim's gamemode is spectator:
        stop
    if victim's gamemode is creative:
        stop
    # トーテム所持時は通常のトーテム処理に任せる
    if victim's tool is totem of undying:
        stop
    if offhand tool of victim is totem of undying:
        stop
    if final damage is less than victim's health:
        stop

    cancel event
    set {_v} to victim

    pvpApplyDeath({_v})
    set {pvp.spectating::%uuid of {_v}%} to true

    set {_dropItems} to {@drop-items}
    if {_dropItems} is true:
        loop all items in inventory of {_v}:
            drop loop-item at location of {_v}
        clear inventory of {_v}

    # 状態を整えてその場でスペクテイターへ
    heal {_v}
    set {_v}'s food level to 20
    extinguish {_v}
    set {_v}'s gamemode to spectator

    pvpRespawnCountdown({_v})

# 予備: 上の処理をすり抜けた死亡(/kill、他プラグインによるダメージなど)
# 死亡地点を覚えておき、リスポーン時にその位置へ戻してスペクテイターにする。
# リスポーン画面を出さないには、サーバーのゲームルール immediate_respawn
# (旧名 doImmediateRespawn)を true にしておくこと。
on death of player:
    # PvP開催外の死亡も含め、死亡時には発光を解除する。
    execute console command "effect clear %victim% minecraft:glowing"
    if {pvp.running} is not true:
        stop
    if victim does not have scoreboard tag "pvp":
        stop

    # バニラ標準の死亡メッセージと重複しないようにする
    set death message to ""
    pvpApplyDeath(victim)
    set {pvp.deathLoc::%uuid of victim%} to location of victim
    set {pvp.spectating::%uuid of victim%} to true

on respawn:
    if {pvp.running} is not true:
        stop
    if {pvp.deathLoc::%uuid of player%} is not set:
        stop

    set respawn location to {pvp.deathLoc::%uuid of player%}
    set {_v} to player
    delete {pvp.deathLoc::%uuid of {_v}%}

    wait 1 tick
    if {_v} is online:
        set {_v}'s gamemode to spectator
        pvpRespawnCountdown({_v})

# 接近警報：1秒ごとに確認。
# 警報音は「接近されたサバイバル側」にだけ送る。

# p の15ブロック以内に、スペクテイター(pvpタグ持ち)がいるか。
# ループが入れ子になると loop-player が曖昧になるため、関数に分けている。
function pvpNearSpectator(p: player) :: boolean:
    loop all players:
        if loop-player is not {_p}:
            if loop-player has scoreboard tag "pvp":
                if loop-player's gamemode is spectator:
                    if world of loop-player is world of {_p}:
                        if distance between loop-player and {_p} <= 15:
                            return true
    return false

every 1 second:
    if {pvp.running} is not true:
        stop

    loop all players:
        if loop-player has scoreboard tag "pvp":
            if loop-player's gamemode is survival:
                if pvpNearSpectator(loop-player) is true:
                    if {pvp.alarm::%uuid of loop-player%} is not set:
                        play sound "block.note_block.bell" with volume 1 and pitch 1.2 to loop-player
                        set {pvp.alarm::%uuid of loop-player%} to now
                    else:
                        if difference between now and {pvp.alarm::%uuid of loop-player%} is not less than 0.9 seconds:
                            play sound "block.note_block.bell" with volume 1 and pitch 1.2 to loop-player
                            set {pvp.alarm::%uuid of loop-player%} to now
                else:
                    delete {pvp.alarm::%uuid of loop-player%}

on join:
    if {pvp.running} is true:
        if player has scoreboard tag "pvp":
            if {pvp.score::%uuid of player%} is not set:
                set {pvp.score::%uuid of player%} to 0
            execute console command "scoreboard players set %player% {@objective} %{pvp.score::%uuid of player%}%"

# タグとスコアボードの同期(1秒ごと)
#  ・pvp タグを外された人 → スコアボードの記録と得点を消す
#  ・開催中に pvp タグを付けられた人 → 0点で登録する
every 1 second:
    loop all players:
        if loop-player has scoreboard tag "pvp":
            if {pvp.running} is true:
                if {pvp.score::%uuid of loop-player%} is not set:
                    set {pvp.score::%uuid of loop-player%} to 0
                    execute console command "scoreboard players set %loop-player% {@objective} 0"
        else:
            if {pvp.score::%uuid of loop-player%} is set:
                execute console command "scoreboard players reset %loop-player% {@objective}"
                delete {pvp.score::%uuid of loop-player%}
                delete {pvp.lastAttacker::%uuid of loop-player%}
                delete {pvp.lastAttackerTime::%uuid of loop-player%}

# ============================================================
#  活動範囲の制限 (長方形=直方体)
#  /pvparea pos1 [x y z]   角1を設定(座標を省略すると今の位置)
#  /pvparea pos2 [x y z]   角2を設定(座標を省略すると今の位置)
#  /pvparea spawn [x y z]  「戻される座標」を設定(範囲内にすること。座標入力時はブロックの中心)
#  ※プレイヤー実行時はそのワールド、コンソール/コマンドブロック実行時は保存済みの対象ワールド
#  /pvparea on|off    制限の有効/無効
#  /pvparea info      現在の設定を表示
#  ・pvp タグ持ち全員が対象(スペクテイター含む)
#  ・範囲外に出ると、指定した座標にテレポートさせる(高さも制限)
#  ・別ワールドにいる人は対象外
# ============================================================

# l が範囲内か(ブロック単位で、角1・角2のブロックを含む)
function pvpAreaContains(l: location) :: boolean:
    if world of {_l} is not world of {pvp.area.p1}:
        return false
    set {_x1} to floor(min(x-coordinate of {pvp.area.p1}, x-coordinate of {pvp.area.p2}))
    set {_x2} to floor(max(x-coordinate of {pvp.area.p1}, x-coordinate of {pvp.area.p2})) + 1
    set {_y1} to floor(min(y-coordinate of {pvp.area.p1}, y-coordinate of {pvp.area.p2}))
    set {_y2} to floor(max(y-coordinate of {pvp.area.p1}, y-coordinate of {pvp.area.p2})) + 1
    set {_z1} to floor(min(z-coordinate of {pvp.area.p1}, z-coordinate of {pvp.area.p2}))
    set {_z2} to floor(max(z-coordinate of {pvp.area.p1}, z-coordinate of {pvp.area.p2})) + 1
    set {_x} to x-coordinate of {_l}
    set {_y} to y-coordinate of {_l}
    set {_z} to z-coordinate of {_l}
    if {_x} < {_x1}:
        return false
    if {_x} >= {_x2}:
        return false
    if {_y} < {_y1}:
        return false
    if {_y} >= {_y2}:
        return false
    if {_z} < {_z1}:
        return false
    if {_z} >= {_z2}:
        return false
    return true

command /pvparea <text> [<number>] [<number>] [<number>]:
    description: PvPの活動範囲(直方体)を設定・有効化する
    usage: /pvparea <pos1|pos2|spawn> [x y z] | <on|off|info>
    permission: pvp.admin
    executable by: players, console, command blocks
    trigger:
        # コマンドブロック/コンソールでは、保存済みの対象ワールドを使う。
        # 未設定なら、オンラインの pvp タグ持ちプレイヤーからワールドを取得する。
        if sender is a player:
            set {_areaWorld} to world of sender
            set {pvp.area.world} to {_areaWorld}
        else:
            if {pvp.area.world} is set:
                set {_areaWorld} to {pvp.area.world}
            else:
                loop all players:
                    if loop-player has scoreboard tag "pvp":
                        set {_areaWorld} to world of loop-player
                        set {pvp.area.world} to {_areaWorld}
                        stop loop
                if {_areaWorld} is not set:
                    send "{@prefix} &c対象ワールドが未設定です。PvP参加者がオンラインの状態でプレイヤーから /pvparea pos1 を実行するか、先にワールドを設定してください。" to sender
                    stop

        # 座標省略時はプレイヤーの現在位置のみ使用可能。
        if arg-2 is set:
            if arg-3 is not set:
                send "{@prefix} &c座標は x y z の3つを入力してください。" to sender
                stop
            if arg-4 is not set:
                send "{@prefix} &c座標は x y z の3つを入力してください。" to sender
                stop
            set {_loc} to location(arg-2, arg-3, arg-4, {_areaWorld})
            set {_spawn} to location(arg-2 + 0.5, arg-3, arg-4 + 0.5, {_areaWorld})
        else:
            if sender is not a player:
                set {_mode} to arg-1
                set {_needCoord} to true
                if {_mode} is "on":
                    set {_needCoord} to false
                if {_mode} is "off":
                    set {_needCoord} to false
                if {_mode} is "info":
                    set {_needCoord} to false
                if {_needCoord} is true:
                    send "{@prefix} &cコマンドブロック/コンソールでは座標 x y z を指定してください。" to sender
                    stop
            else:
                set {_loc} to location of sender
                set {_spawn} to location of sender

        if arg-1 is "pos1":
            set {pvp.area.p1} to {_loc}
            set {pvp.area.world} to {_areaWorld}
            send "{@prefix} &a角1を設定しました: %floor(x-coordinate of {_loc})%, %floor(y-coordinate of {_loc})%, %floor(z-coordinate of {_loc})% (ワールド: %{_areaWorld}%)" to sender
        else if arg-1 is "pos2":
            set {pvp.area.p2} to {_loc}
            set {pvp.area.world} to {_areaWorld}
            send "{@prefix} &a角2を設定しました: %floor(x-coordinate of {_loc})%, %floor(y-coordinate of {_loc})%, %floor(z-coordinate of {_loc})% (ワールド: %{_areaWorld}%)" to sender
        else if arg-1 is "spawn":
            set {pvp.area.spawn} to {_spawn}
            set {pvp.area.world} to {_areaWorld}
            send "{@prefix} &a戻り座標を設定しました: %x-coordinate of {_spawn}%, %y-coordinate of {_spawn}%, %z-coordinate of {_spawn}% (ワールド: %{_areaWorld}%)" to sender
        else if arg-1 is "on":
            if {pvp.area.p1} is not set:
                send "{@prefix} &c先に /pvparea pos1 と pos2 で範囲を設定してください。" to sender
                stop
            if {pvp.area.p2} is not set:
                send "{@prefix} &c先に /pvparea pos1 と pos2 で範囲を設定してください。" to sender
                stop
            if {pvp.area.spawn} is not set:
                send "{@prefix} &c先に /pvparea spawn で戻り座標を設定してください。" to sender
                stop
            if world of {pvp.area.p1} is not world of {pvp.area.p2}:
                send "{@prefix} &c角1と角2が別のワールドです。" to sender
                stop
            if world of {pvp.area.p1} is not world of {pvp.area.spawn}:
                send "{@prefix} &c戻り座標が別のワールドです。" to sender
                stop
            if pvpAreaContains({pvp.area.spawn}) is false:
                send "{@prefix} &c戻り座標が範囲の外です。設定を確認してください。" to sender
                stop
            set {pvp.area.on} to true
            send "{@prefix} &a活動範囲の制限を有効にしました。" to sender
        else if arg-1 is "off":
            set {pvp.area.on} to false
            send "{@prefix} &e活動範囲の制限を無効にしました。" to sender
        else if arg-1 is "info":
            if {pvp.area.on} is true:
                send "{@prefix} &a制限: 有効" to sender
            else:
                send "{@prefix} &e制限: 無効" to sender
            send "{@prefix} ワールド: %{pvp.area.world}%" to sender
            send "{@prefix} 角1: %{pvp.area.p1}% / 角2: %{pvp.area.p2}%" to sender
            send "{@prefix} 戻り座標: %{pvp.area.spawn}%" to sender
        else:
            send "{@prefix} &c使い方: /pvparea <pos1|pos2|spawn> [x y z] | <on|off|info>" to sender

# 0.25秒ごとに確認し、範囲外のpvpタグ持ち(スペクテイター含む)を戻す
every 5 ticks:
    if {pvp.area.on} is not true:
        stop
    loop all players:
        if loop-player has scoreboard tag "pvp":
            if world of loop-player is world of {pvp.area.p1}:
                if pvpAreaContains(location of loop-player) is false:
                    teleport loop-player to {pvp.area.spawn}
                    set velocity of loop-player to vector(0, 0, 0)
                    send action bar "&c活動範囲の外には出られません" to loop-player
